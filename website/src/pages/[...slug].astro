---
import "../styles/global.css";
import Layout from "../layouts/index.astro";
import Text from "../components/text/text.astro";
import BlockRenderer from "../components/blockRenderer/blockRenderer.astro";
import { getPayload } from "payload";
import { config } from "../../../payload-app/src/index";

const { slug } = Astro.params;

const payload = await getPayload({ config });
const { docs } = await payload.find({
  collection: "pages",
  where: { slug: { equals: slug } },
  limit: 2,
});

if (docs.length === 0) {
  return new Response(null, { status: 404, statusText: "Not Found here mate" });
}
const page = docs[0];
console.log("Page log paragraph:", page.content.root.children);
---

<Layout title={page.title}>
  <BlockRenderer blocks={page.group?.heroBlocks} />
  <div class={"max-w-1/2 mx-auto w-full mb-10"}>
    {
      page.content.root.children.map((content) => {
        console.log("content log", content.type);
        if (content.tag === "h2") {
          return (
            <>
              {content.children.map((child) => (
                <Text
                  as="h2"
                  class="!text-gray-500"
                  font="fontHeadings"
                  weight="bold"
                >
                  {child.text}
                </Text>
              ))}
            </>
          );
        } else if (content.tag === "h3") {
          return (
            <>
              {content.children.map((child) => (
                <Text
                  as="h3"
                  class="!text-gray-500"
                  font="fontHeadings"
                  weight="bold"
                >
                  {child.text}
                </Text>
              ))}
            </>
          );
        } else if (content.type === "paragraph") {
          return (
            <>
              {content.children.map((child) => (
                <Text as="p" class="!text-gray-500" font="fontBody">
                  {child.text}
                </Text>
              ))}
            </>
          );
        }
      })
    }
  </div>
  <BlockRenderer blocks={page.group?.contentBlocks?.blocks} />
</Layout>
