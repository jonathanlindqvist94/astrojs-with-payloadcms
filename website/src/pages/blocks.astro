---
import "../styles/global.css";
import Layout from "../layouts/index.astro";
import BlockRenderer from "../components/blockRenderer/blockRenderer.astro";
import { getPayload } from "payload";
import { config } from "../../../payload-app/src/index";

const payload = await getPayload({ config });
const blocks = await payload.findGlobal({
  slug: "blocks",
});
---

<Layout title={blocks.title}>
  {
    blocks.group?.heroBlocks && (
      <BlockRenderer blocks={blocks.group.heroBlocks} />
    )
  }
  {
    blocks.group?.contentBlocks && (
      <BlockRenderer blocks={blocks.group.contentBlocks.blocks} />
    )
  }
</Layout>
