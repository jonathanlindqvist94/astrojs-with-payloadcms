---
import "../styles/global.css";
import Layout from "../layouts/index.astro";
import BlockRenderer from "../components/blockRenderer/blockRenderer.astro";
import { getPayload } from "payload";
import { config } from "../../../payload-app/src/index";

const payload = await getPayload({ config });
const homepage = await payload.findGlobal({
  slug: "homepage",
});
---

<Layout title={homepage.title}>
  {
    homepage.group?.heroBlocks && (
      <BlockRenderer blocks={homepage.group.heroBlocks} />
    )
  }
  {
    homepage.group?.contentBlocks && (
      <BlockRenderer blocks={homepage.group?.contentBlocks?.blocks} />
    )
  }
</Layout>
