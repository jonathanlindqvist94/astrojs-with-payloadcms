---
import Text from "../text/text.astro";

interface Props {
  title: string;
  content: string;
}

const { items, image, imagePosition, openAtOnce } = Astro.props;
// console.log(content.root.children.map((item) => item.type));
// console.log(imagePosition);
// console.log(openAtOnce);
const imageSrc = image?.url
  ? `${import.meta.env.PUBLIC_PAYLOAD_URL}${image.url}`
  : "";
---

<div
  class={"layout-max-width w-full grid-layout-accordion relative max-h-180 mb-20"}
>
  <img
    src={imageSrc}
    alt={"alt"}
    class={"object-cover sm:col-start-1 sm:col-end-6 col-span-full row-span-full h-full max-h-[45rem]"}
  />
  <div
    class={"flex flex-col row-start-1 lg:col-start-4 sm:col-start-3 col-span-full sm:my-30 h-max shadow-lg bg-white py-6 px-4"}
  >
    {
      items.map((item) => {
        return (
          <details
            class={"col-span-full accordion-sub-grid group"}
            name={openAtOnce === "One" ? "accordion" : ""}
          >
            <summary
              class={
                item.length > 1
                  ? "flex justify-between cursor-pointer hover:underline"
                  : "flex justify-between cursor-pointer hover:underline mb-4"
              }
            >
              <Text
                as="h2"
                class=""
                color="black"
                font="fontHeadings"
                margin={false}
                weight="black"
              >
                {item.title}
              </Text>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                height="32px"
                viewBox="0 -960 960 960"
                width="32px"
                fill="#1f1f1f"
                class="group-open:rotate-180 transition-transform self-center"
              >
                <path d="M480-344 240-584l56-56 184 184 184-184 56 56-240 240Z" />
              </svg>
            </summary>
            {item.content.root.children.map((paragraph) => {
              return (
                <div class={"ml-5 pl-4 border-l-2 border-blue-400 mt-4"}>
                  {paragraph.children.map((textNode) => (
                    <Text as="p" class="!text-gray-500" font="fontBody">
                      {textNode.text}
                    </Text>
                  ))}
                </div>
              );
            })}
          </details>
        );
      })
    }
  </div>
</div>
