---
import type { Picture } from "astro:assets";
import Text from "../text/text.astro";
import { pathHasLocale } from "astro:i18n";
import Richtext from "../richtext/richtext.astro";
const { title, ingress, customerReviews, backgroundColor } = Astro.props;

console.log("customer reviews:", customerReviews);
---

<section
  class={`${backgroundColor} flex flex-col items-center px-15 py-20 mb-20`}
>
  <div class="">
    <Text
      id="customerFeedbackTitle"
      as="h2"
      font="fontHeadings"
      class="text-center">{title}</Text
    >
    <Text as="p" font="fontBody" class="text-center">{ingress}</Text>
  </div>
  <div>
    <div class="flex gap-4 items-center">
      <svg
        width="200"
        height="200"
        viewBox="0 0 48 48"
        xmlns="http://www.w3.org/2000/svg"
        class="text-green-700"
        ><path
          fill="currentColor"
          fill-rule="evenodd"
          d="M18.853 9.116Q7.558 16.37 6.303 26.003C5 36 13.94 40.893 18.47 36.497s1.815-9.977-1.465-11.503s-5.286-.994-4.936-3.033s5.016-7.69 9.116-10.322a.75.75 0 0 0 .114-1.02L20.285 9.3c-.44-.572-.862-.55-1.432-.185m19.826.001q-11.295 7.254-12.55 16.887C24.825 36 33.765 40.893 38.295 36.497s1.815-9.977-1.466-11.503s-5.286-.994-4.936-3.033s5.017-7.69 9.117-10.322a.75.75 0 0 0 .113-1.02L40.11 9.3c-.44-.572-.862-.55-1.431-.185"
          clip-rule="evenodd"></path></svg
      >
      <div class="flex flex-col">
        {
          customerReviews.map((item) => {
            console.log(item);
            return (
              <>
                {item.highlightReview && (
                  <>
                    <Richtext content={item.customerContent} />
                    <Text as="p">- {item.customerName}</Text>
                  </>
                )}
              </>
            );
          })
        }
      </div>
    </div>
    <div class="px-16 py-6 flex gap-6">
      {
        customerReviews.map((item) => {
          console.log("item item log", item);
          return (
            <>
              {!item.highlightReview && (
                <div class="flex flex-col px-4 py-4 bg-green-800/5">
                  <Richtext content={item.customerContent} />
                  <Text as="p">- {item.customerName}</Text>
                </div>
              )}
            </>
          );
        })
      }
    </div>
  </div>
</section>
