---
import Text from "../text/text.astro";
import { Image } from "astro:assets";

const { title, description, image, link } = Astro.props;
const imageSrc = image?.url
  ? `${import.meta.env.PUBLIC_PAYLOAD_URL}${image.url}`
  : "";
---

<section
  aria-labelledby="about-me-title"
  class="flex md:flex-row flex-col w-full md:gap-20 gap-10 mb-20"
>
  <div class="flex flex-col md:w-1/2 w-full self-center">
    <Text id="about-me-title" as="h2" font="fontHeadings" weight="black">
      {title}
    </Text>
    <Text as="p" font="fontBody" weight="default">
      {description}
    </Text>
    <a
      href={`posts/${link.reference.value.slug}`}
      class="px-6 py-3 rounded-lg bg-blue-700 cursor w-max text-white"
      >{link.label}</a
    >
  </div>
  <Image
    height={image.height}
    width={image.width}
    src={imageSrc}
    alt={image?.alt}
    class="md:w-1/2 w-full object-cover"
  />
</section>
