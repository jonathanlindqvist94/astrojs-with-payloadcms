---
import { getPayload } from "payload";
import { config } from "../../../../payload-app/src/index";
import { HamburgerMenu } from "./hamburger/hamburgerMenu";
import DefaultMenu from "./defaultMenu/defaultMenu.astro";

const payload = await getPayload({ config });

const navLinks = await payload.findGlobal({
  slug: "navigation",
  depth: 2,
});

const items = navLinks?.navItems?.map((item) => ({
  type: item.link.type,
  label: item.link.label,
  slug:
    item.link.type === "reference"
      ? item.link.reference?.value.slug
      : item.link.url,
  openInNewTab: item.link.newTab || false,
}));
const displayAs = navLinks.displayAs || "normal";
---

<header class="flex px-4 h-20 relative mb-20">
  <div
    class="flex px-inline-padding justify-between max-w-layout-max-width items-center w-full mx-auto"
  >
    <img src="https://picsum.dev/100/50" alt="" />
    {
      displayAs === "hamburger" ? (
        <HamburgerMenu client:load items={items} />
      ) : (
        <DefaultMenu items={items} />
      )
    }
  </div>
</header>
