---
import Text from "../text/text.astro";
import linkedIn from "../../icons/linkedin.astro";
import { Image } from "astro:assets";

const { role, name, description, image, group } = Astro.props;
const imageSrc = image?.url
  ? `${import.meta.env.PUBLIC_PAYLOAD_URL}${image.url}`
  : "";
const readableDate = new Date(group.bornDate).toLocaleDateString("sv-SE", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<section class="flex md:flex-row flex-col md:gap-40 gap-10 mb-20 w-full">
  <div class="md:max-w-[70%] w-full">
    <Text as="p" margin={false} font="fontBody" class="!text-blue-700"
      >{role}</Text
    >
    <Text as="h1" class="" font="fontHeadings">
      {name}
    </Text>
    <Text as="p" margin={false} font="fontBody" class="!text-blue-700"
      >{description}</Text
    >
    <div
      class="ml-12 pl-8 mt-8 border-l-2 border-blue-400 py-4 flex flex-col gap-1"
    >
      <Text as="p" margin={false} font="fontBody">
        <Text as="span" class="text-stone-500">Född i</Text>
        {group.bornIn}</Text
      >
      <Text as="p" margin={false} font="fontBody">
        <Text as="span" class="text-stone-500">Erfarenhet</Text>
        {group.experience}</Text
      >
      <date>
        <Text as="span" font="fontBody" class="text-stone-500">Född den</Text>
        {readableDate}</date
      >
      <ul class="flex gap-2">
        {
          group.socialLinks &&
            group.socialLinks.map((link) => {
              if (!link.link.url) return null;
              let Icon = null;
              if (link.link.url.includes("linkedin")) {
                Icon = linkedIn;
              }
              const linkURL =
                link.link.type === "reference"
                  ? link.link.reference.value.slug
                  : link.link.url;
              const openInNewTab = link.link.newTab || false;
              return (
                <li>
                  <a
                    href={linkURL}
                    class="font-family-body"
                    aria-label={link.link.label}
                    {...(openInNewTab
                      ? { target: "_blank", rel: "noopener noreferrer" }
                      : {})}
                  >
                    {Icon && <Icon />}
                  </a>
                </li>
              );
            })
        }
      </ul>
    </div>
  </div>
  <Image
    height={image.height}
    width={image.width}
    src={imageSrc}
    alt={image.alt}
    class="md:max-w-[35%] w-full rounded-tr-[8rem] rounded-bl-[8rem] rounded-tl-lg rounded-br-lg h-100 aspect-square shadow-2xl p-4 object-cover"
  />
</section>
