---
import Text from "../text/text.astro";
const { title, description, imageArray } = Astro.props;
---

<div class="flex lg:flex-row flex-col gap-10 mb-20">
  <div class="lg:w-1/3 w-full self-center">
    <Text as="h2" font="fontHeadings" weight="bold">{title}</Text>
    <Text as="p" font="fontBody" weight="regular">{description}</Text>
  </div>
  <div class="lg:w-2/3 w-full relative h-[500px]">
    {
      imageArray.map((image, index) => {
        const imageSrc = image.image?.url
          ? `${import.meta.env.PUBLIC_PAYLOAD_URL}${image.image.url}`
          : "";

        // Position classes for each image
        const positionClasses = [
          // First image
          "left-12 top-1/4 w-[35%] h-[70%] z-10 rounded-lg",
          // Second image
          "left-[30%] top-0 w-[40%] h-[45%] z-20",
          // Third image
          "right-0 top-[25%] w-[45%] h-[60%] z-30 rounded-lg",
        ];

        return (
          <img
            src={imageSrc}
            alt={image.image?.alt || ""}
            class={`absolute object-cover ${positionClasses[index] || ""}`}
          />
        );
      })
    }
  </div>
</div>
