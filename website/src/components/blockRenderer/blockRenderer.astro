---
// components/BlockRenderer.astro
import type { Block } from "../../../../payload-app/src/index";

// Import all your block components
// import HeroBlock from "./blocks/HeroBlock.astro";
// import TextBlock from "./blocks/TextBlock.astro";
// import ImageBlock from "./blocks/ImageBlock.astro";
// import CallToActionBlock from "./blocks/CTABlock.astro";
// ... add more as needed

import AccordionBlock from "../accordion/accordion.astro";
import InfoBlock from "../infoBlock.astro";

interface Props {
  block: Block;
}

const { block } = Astro.props;

// Map block types to components
const blockComponents = {
  // hero: HeroBlock,
  // text: TextBlock,
  // image: ImageBlock,
  // cta: CallToActionBlock,
  accordion: AccordionBlock,
  infoBlock: InfoBlock,
  // ... add more mappings
};

const BlockComponent = blockComponents[block.blockType];
if (BlockComponent === InfoBlock) {
  console.log(block);
}
---

{
  BlockComponent ? (
    <BlockComponent {...block} />
  ) : (
    <div class="block-error">
      <p>Unknown block type: {block.blockType}</p>
    </div>
  )
}
