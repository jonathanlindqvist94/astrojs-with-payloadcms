---
// components/BlockRenderer.astro
import type { Block } from "../../../../payload-app/src/index";

import AccordionBlock from "../accordion/accordion.astro";
import ContentWithMedia from "../contentWithMedia/contentWithMedia.astro";
import PersonalHero from "../hero/personalHero.astro";
import InfoBlock from "../infoBlock/infoBlock.astro";
import LeftRight from "../leftRight/leftRight.astro";
import Text from "../text/text.astro";

interface Props {
  blocks: Block | Block[]; // Accept either single block or array
}

const { blocks } = Astro.props;

// Map block types to components
const blockComponents = {
  personalHero: PersonalHero,
  accordion: AccordionBlock,
  infoBlock: InfoBlock,
  contentWithMedia: ContentWithMedia,
  leftRight: LeftRight,
};

// Normalize to array
const blockArray = Array.isArray(blocks) ? blocks : [blocks];
console.log(blockArray);
---

{
  blockArray.map((block) => {
    const BlockComponent = blockComponents[block.blockType];
    return BlockComponent ? (
      <BlockComponent {...block} />
    ) : (
      <div class="block-error">
        <Text as="span">Unknown block type: {block.blockType}</Text>
      </div>
    );
  })
}
