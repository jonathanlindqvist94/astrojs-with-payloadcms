---
const { title, description, innerContent, image } = Astro.props;
const imageSrc = image?.url
  ? `${import.meta.env.PUBLIC_PAYLOAD_URL}${image.url}`
  : "";
---

<section
  aria-labelledby="infoBlock-title"
  class="max-w-layout-max-width px-inline-padding mb-10"
>
  <div class="flex flex-col gap-2 w-1/2 mb-10">
    <h2
      id="infoBlock-title"
      class="text-heading2-responsive-font-size font-bold"
    >
      {title}
    </h2>
    <p class="!text-gray-500">{description}</p>
  </div>
  <div class="flex flex-row gap-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 w-1/2">
      {
        innerContent.map((item) => {
          const [number, ...rest] = item.innerHeading.split(" ");
          const text = rest.join(" ");
          return (
            <div>
              <h3 class="font-bold text-3xl mb-1">
                {number}
                <span class="block text-lg mt-2">{text}</span>
              </h3>
              <p class="!text-gray-500">{item.innerDescription}</p>
            </div>
          );
        })
      }
    </div>
    <img src={imageSrc} alt={image.alt} class="w-1/2 rounded-lg" />
  </div>
</section>
