---
import Text from "../text/text.astro";

const { title, description, image, link, imagePosition, backgroundColor } =
  Astro.props;
console.log(backgroundColor);

const linkLabel = link.label || link.reference.title;
const linkUrl = link.reference.value.slug;

const imageSrc = image?.url
  ? `${import.meta.env.PUBLIC_PAYLOAD_URL}${image.url}`
  : "";
---

<div
  class={`mb-20 flex gap-20 p-10 rounded-2xl ${backgroundColor} ${imagePosition === "right" ? "flex-row" : "flex-row-reverse"} `}
>
  <div class="w-1/2 self-center flex flex-col">
    <Text as="h2" margin={false} weight="black" class="mb-10">{title}</Text>
    <Text as="p" margin={false} class="mb-10">{description}</Text>
    <a
      href={linkUrl}
      class="px-6 py-4 rounded-lg cursor bg-blue-700 text-white w-max"
      >{linkLabel}</a
    >
  </div>
  <img src={imageSrc} alt={image.alt} class="w-1/2 rounded-2xl" />
</div>
