---
import Text from "../text/text.astro";
import { Image } from "astro:assets";

const { title, description, image, link, imagePosition, backgroundColor } =
  Astro.props;

const linkLabel = link.label || link.reference.title;
const linkUrl = link.reference.value.slug;

const imageSrc = image?.url
  ? `${import.meta.env.PUBLIC_PAYLOAD_URL}${image.url}`
  : "";
---

<div
  class={`mb-20 flex md:gap-20 gap-10 p-10 rounded-2xl ${backgroundColor} ${imagePosition === "right" ? "md:flex-row flex-col" : "md:flex-row-reverse flex-col-reverse"} `}
>
  <div class="md:w-1/2 w-full self-center flex flex-col">
    <Text as="h2" margin={false} weight="black" class="mb-5">{title}</Text>
    <Text as="p" margin={false} class="mb-10">{description}</Text>
    <a
      href={linkUrl}
      class="px-6 py-4 rounded-lg cursor bg-blue-700 text-white w-max"
      >{linkLabel}</a
    >
  </div>
  <Image
    height={image.image?.height}
    width={image.image?.width}
    src={imageSrc}
    alt={image.alt}
    class="md:w-1/2 w-full rounded-2xl"
  />
</div>
