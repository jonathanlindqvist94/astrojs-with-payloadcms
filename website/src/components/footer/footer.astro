---
import { getPayload } from "payload";
import { config } from "../../../../payload-app/src/index";
import Text from "../text/text.astro";

const payload = await getPayload({ config });
const footerData = await payload.findGlobal({ slug: "footer" });
---

<footer class="bg-green-400">
  <div
    class="max-w-layout-max-width px-inline-padding mx-auto py-12 grid md:grid-cols-3 grid-cols-1 gap-20"
  >
    <section aria-labelledby="left-column-title">
      <Text
        as="h2"
        class=""
        id="left-column-title"
        font="fontHeadings"
        weight="semibold"
      >
        {footerData.leftColumn?.title}
      </Text>
      <Text as="p" font="fontBody">
        {footerData.leftColumn?.content}
      </Text>
    </section>
    <section aria-labelledby="center-column-title">
      <Text
        as="h2"
        class=""
        id="center-column-title"
        font="fontHeadings"
        weight="semibold"
      >
        {footerData.middleColumn?.title}
      </Text>
      <nav>
        <ul>
          {
            footerData.middleColumn?.navItemsMiddleCol?.map((item) => {
              const link =
                item.link.type === "reference"
                  ? item.link.reference?.value.slug
                  : item.link.url;
              const openInNewTab = item.link.newTab || false;
              const title = item.link.label;
              const type = item.link.type;
              return (
                <li>
                  <a
                    class="focus:underline font-family-body hover:underline hover:text-blue-700"
                    {...(openInNewTab
                      ? { target: "_blank", rel: "noopener noreferrer" }
                      : {})}
                    href={link}
                  >
                    {title}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
    </section>
    <section aria-labelledby="right-column-title">
      <Text
        as="h2"
        class=""
        id="right-column-title"
        font="fontHeadings"
        weight="semibold"
      >
        {footerData.rightColumn?.title}
      </Text>
      <nav>
        <ul>
          {
            footerData.rightColumn?.navItemsRightCol?.map((item) => {
              const link =
                item.link.type === "reference"
                  ? item.link.reference?.value.slug
                  : item.link.url;
              const openInNewTab = item.link.newTab || false;
              const title = item.link.label;
              const type = item.link.type;
              return (
                <li>
                  <a
                    class="focus:underline hover:underline hover:text-blue-700 font-family-body"
                    {...(openInNewTab
                      ? { target: "_blank", rel: "noopener noreferrer" }
                      : {})}
                    href={link}
                  >
                    {title}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
    </section>
  </div>
</footer>
